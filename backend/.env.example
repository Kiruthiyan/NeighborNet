# Environment Configuration
NODE_ENV=development
DEBUG=true

# AWS Configuration  
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_ENDPOINT_URL=http://localstack:4566  # For local development

# Amazon Bedrock Model Configuration
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Alternative models:
# BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_MODEL_REGION=us-west-2
BEDROCK_MODEL_TEMPERATURE=0.7
BEDROCK_MODEL_MAX_TOKENS=4000

# Strands Configuration
STRANDS_MODEL_PROVIDER=bedrock  # bedrock, mock, openai
STRANDS_LOG_LEVEL=INFO
STRANDS_SESSION_STORAGE=file  # file, s3
STRANDS_SESSION_BASE_DIR=./agent_sessions

# Database Configuration
DATABASE_URL=dynamodb://localhost:8001
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
DYNAMODB_REGION=us-west-2

# Set to true once AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY below are filled in
# with a real IAM user that has DynamoDB access. When true, every teammate
# running the backend against the same AWS account/region shares the same
# live data (volunteers, disasters, tasks, decisions) instead of each
# getting their own reset-on-restart in-memory copy. Leave false for solo
# local dev / running the test suite without AWS.
PERSIST_TO_DYNAMODB=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-in-production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Demo Configuration
DEMO_MODE=true
DEMO_DATA_RESET_ON_START=false

# Email (invitation delivery) - Gmail SMTP + App Password.
# 1. Turn on 2-Step Verification on the sending Gmail account.
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
#    (app: Mail, device: Other -> "NeighborNet"). Use that 16-char code below,
#    NOT your normal Gmail password.
# Leave SMTP_USERNAME/SMTP_PASSWORD unset to skip sending - invitations still
# work, the admin panel just shows a copy/paste signup link instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=NeighborNet
# Where the frontend is served, so invitation emails link to a real signup page.
FRONTEND_BASE_URL=http://localhost:3000

# Notification Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:neighbornet-notifications
SNS_ENDPOINT_URL=http://localstack:4566  # For local development

# Audit Configuration  
AUDIT_S3_BUCKET=neighbornet-audit-logs
S3_ENDPOINT_URL=http://localstack:4566  # For local development

# Monitoring Configuration
CLOUDWATCH_NAMESPACE=NeighborNet/Resilience
CLOUDWATCH_ENDPOINT_URL=http://localstack:4566  # For local development

# Security Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60